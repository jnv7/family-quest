{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jnv7.github.io/family-quest/schemas/theme.schema.json",
  "title": "Theme package: theme.json",
  "description": "See SPEC.md §8 and docs/architecture.md §6. The folder name under src/themes/ must equal `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "locale",
    "roles",
    "tiers",
    "rewardArt",
    "profileSymbols",
    "map",
    "places",
    "homeVariants",
    "character",
    "install",
    "tokenArt",
    "vault"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "locale": {
      "const": "pt-PT"
    },
    "roles": {
      "description": "Visible names for every role of the neutral glossary (SPEC.md §3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "profile",
        "board",
        "checkin",
        "home",
        "vault",
        "showcase",
        "reward",
        "collectible",
        "party",
        "reserve",
        "token"
      ],
      "properties": {
        "world": {
          "$ref": "#/$defs/noun"
        },
        "profile": {
          "$ref": "#/$defs/noun"
        },
        "board": {
          "$ref": "#/$defs/noun"
        },
        "checkin": {
          "$ref": "#/$defs/noun"
        },
        "home": {
          "$ref": "#/$defs/noun"
        },
        "vault": {
          "$ref": "#/$defs/noun"
        },
        "showcase": {
          "$ref": "#/$defs/noun"
        },
        "reward": {
          "$ref": "#/$defs/noun"
        },
        "collectible": {
          "$ref": "#/$defs/noun"
        },
        "party": {
          "$ref": "#/$defs/noun"
        },
        "reserve": {
          "$ref": "#/$defs/noun"
        },
        "token": {
          "$ref": "#/$defs/noun"
        }
      }
    },
    "tiers": {
      "description": "Visible names of the three tiers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "mid",
        "high"
      ],
      "properties": {
        "low": {
          "$ref": "#/$defs/label"
        },
        "mid": {
          "$ref": "#/$defs/label"
        },
        "high": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "rewardArt": {
      "description": "Art of an unopened reward, per tier. The tier is visible before opening.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "mid",
        "high"
      ],
      "properties": {
        "low": {
          "$ref": "#/$defs/art"
        },
        "mid": {
          "$ref": "#/$defs/art"
        },
        "high": {
          "$ref": "#/$defs/art"
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "aspectRatio"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/art"
        },
        "aspectRatio": {
          "description": "Width divided by height of the map.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "moorings": {
          "description": "Optional spots where the engine draws one boat per profile of a kind, using homeVariants (SPEC.md §7).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adult": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "spots",
                "symbolAt"
              ],
              "properties": {
                "spots": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/spot"
                  }
                },
                "symbolAt": {
                  "description": "Where the profile's symbol goes on the boat: centre (x, y) and size, in percent of the spot; size is a share of the spot's width.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "size"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "size": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            },
            "child": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "spots",
                "symbolAt"
              ],
              "properties": {
                "spots": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/spot"
                  }
                },
                "symbolAt": {
                  "description": "Where the profile's symbol goes on the boat: centre (x, y) and size, in percent of the spot; size is a share of the spot's width.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "size"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "size": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "places": {
      "description": "The five tappable places on the map.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "checkin",
        "home",
        "vault",
        "showcase"
      ],
      "properties": {
        "board": {
          "$ref": "#/$defs/place"
        },
        "checkin": {
          "$ref": "#/$defs/place"
        },
        "home": {
          "$ref": "#/$defs/place"
        },
        "vault": {
          "$ref": "#/$defs/place"
        },
        "showcase": {
          "$ref": "#/$defs/place"
        }
      }
    },
    "homeVariants": {
      "description": "Look of the home place per profile kind.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adult",
        "child"
      ],
      "properties": {
        "adult": {
          "$ref": "#/$defs/art"
        },
        "child": {
          "$ref": "#/$defs/art"
        }
      }
    },
    "character": {
      "description": "The checkin character and its fixed set of short lines. The engine picks one line of each kind at random.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "art",
        "lines"
      ],
      "properties": {
        "art": {
          "$ref": "#/$defs/art"
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "greeting",
            "congrats",
            "doubt",
            "farewell"
          ],
          "properties": {
            "greeting": {
              "$ref": "#/$defs/lines"
            },
            "congrats": {
              "$ref": "#/$defs/lines"
            },
            "doubt": {
              "description": "Said when the answer to the question is no.",
              "$ref": "#/$defs/lines"
            },
            "farewell": {
              "$ref": "#/$defs/lines"
            }
          }
        }
      }
    },
    "install": {
      "description": "How the installed app looks: its name and icons. One web app manifest per theme is generated from this at build time (SPEC.md §8, ADR 0005).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "themeColor",
        "backgroundColor",
        "icons"
      ],
      "properties": {
        "name": {
          "description": "The name under the home screen icon.",
          "$ref": "#/$defs/label"
        },
        "themeColor": {
          "$ref": "#/$defs/color"
        },
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "large",
            "maskable",
            "apple"
          ],
          "properties": {
            "small": {
              "description": "192 x 192 px.",
              "$ref": "#/$defs/icon"
            },
            "large": {
              "description": "512 x 512 px.",
              "$ref": "#/$defs/icon"
            },
            "maskable": {
              "description": "512 x 512 px, with the drawing inside the central 60%.",
              "$ref": "#/$defs/icon"
            },
            "apple": {
              "description": "180 x 180 px, for the iOS home screen.",
              "$ref": "#/$defs/icon"
            }
          }
        }
      }
    },
    "profileSymbols": {
      "description": "Emoji suggested first when a profile chooses its symbol. At least 12, without duplicates, one emoji each (checked by validate-theme). The picker offers every emoji, so a symbol is not limited to this list.",
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      }
    },
    "homeSymbolAt": {
      "description": "Optional, per profile kind: where the profile's symbol goes over the `homeVariants` art on the home, as the centre (x, y) and size, in percent of the art; size is a share of its width. Without it, the symbol is shown next to the name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "size"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        },
        "child": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "size"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "tokenArt": {
      "description": "Art of one token, shown in the balance, the prices and the earned row.",
      "$ref": "#/$defs/art"
    },
    "vault": {
      "description": "How the vault shows the three tiers a person can open for tokens. Without background, aspectRatio and spots the engine stacks the tiers from the entrance (low) to the deep end (high); with them it places each tier on the background (SPEC.md §7).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invite"
      ],
      "properties": {
        "invite": {
          "description": "One short line per tier that invites going deeper.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "mid",
            "high"
          ],
          "properties": {
            "low": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "mid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "high": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "background": {
          "$ref": "#/$defs/art"
        },
        "aspectRatio": {
          "description": "Width divided by height of the background.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spots": {
          "description": "Where each tier sits on the background, in percent.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "mid",
            "high"
          ],
          "properties": {
            "low": {
              "$ref": "#/$defs/spot"
            },
            "mid": {
              "$ref": "#/$defs/spot"
            },
            "high": {
              "$ref": "#/$defs/spot"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "noun": {
      "description": "A Portuguese noun. The engine derives articles and contractions from `gender` (docs/architecture.md §6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singular",
        "plural",
        "gender"
      ],
      "properties": {
        "singular": {
          "$ref": "#/$defs/label"
        },
        "plural": {
          "$ref": "#/$defs/label"
        },
        "gender": {
          "enum": [
            "m",
            "f"
          ]
        }
      }
    },
    "art": {
      "description": "Either an image file relative to the theme's folder, or an emoji (minimal themes).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^assets/[a-z0-9][a-z0-9._/-]*\\.(png|webp|svg)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "emoji"
          ],
          "properties": {
            "emoji": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            }
          }
        }
      ]
    },
    "place": {
      "description": "Position and size in percent of the map's width and height (0-100), measured from the top-left corner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "art",
        "transition"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "art": {
          "$ref": "#/$defs/art"
        },
        "transition": {
          "description": "The short animation played when the place is tapped.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "durationMs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "move",
                "fade",
                "none"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1500
            }
          }
        },
        "symbolAt": {
          "description": "Optional. Where the active profile's symbol goes over this place's art, as the centre (x, y) and size, in percent of the area the art is drawn in; size is a share of its width. Used only when the art is the `homeVariants` art of the profile's kind (the big ship at the pier, for adults).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "size"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^assets/[a-z0-9][a-z0-9._/-]*\\.png$"
        }
      }
    },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
